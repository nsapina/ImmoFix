# Diese Datei auf EC2 als .env.aws speichern und alle CHANGE_ME-Werte ersetzen.
# .env.aws darf niemals in Git committed werden.

POSTGRES_USER=immofix
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=immofix

MONGO_USER=immofix
MONGO_PASSWORD=CHANGE_ME_MONGO
MONGO_DB=immofix_events

APP_ENV=production

# Bei Deployment über die öffentliche EC2-IP:
CORS_ORIGINS=http://EC2_PUBLIC_IP

# Die Basis-Compose-Datei verwendet diese Werte für Host-Port-Mappings.
API_PORT=8000
WEB_PORT=80

ADMIN_EMAIL=admin@immofix.de
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=ImmoFix Administration

# Beispiel zur Generierung: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=480
