# Diese Datei auf EC2 als .env.aws speichern und alle Platzhalter ersetzen.
# .env.aws darf niemals in Git committed werden.

APP_ENV=production

# Private AWS-RDS-PostgreSQL-Verbindung
DATABASE_URL=postgresql+psycopg://immofix_app:CHANGE_ME@YOUR_RDS_ENDPOINT:5432/immofix?sslmode=require

# MongoDB läuft ausschließlich im Docker-Netzwerk der EC2-Instanz
MONGO_USER=immofix
MONGO_PASSWORD=CHANGE_ME_TOO
MONGO_DB=immofix_events
MONGO_URL=mongodb://immofix:CHANGE_ME_TOO@mongo:27017/immofix_events?authSource=admin

CORS_ORIGINS=https://YOUR_DOMAIN

ADMIN_EMAIL=admin@YOUR_DOMAIN
ADMIN_PASSWORD=CHANGE_TO_A_LONG_PASSWORD
ADMIN_NAME=ImmoFix Administration
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=240
